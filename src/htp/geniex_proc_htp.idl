#ifndef GENIEX_PROC_HTP_IDL
#define GENIEX_PROC_HTP_IDL

#include "AEEStdDef.idl"
#include "remote.idl"

interface geniex_proc_htp : remote_handle64 {
    AEEResult echo(in sequence<octet> input, rout sequence<octet> output);
    AEEResult resize(in int32 source_height, in int32 source_width,
