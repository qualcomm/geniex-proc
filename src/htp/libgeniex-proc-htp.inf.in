[Version]
Signature   = "$WINDOWS NT$"
Class       = ComputeAccelerator
ClassGuid   = {F01A9D53-3FF6-48D2-9F97-C8A7004BE10C}
Provider    = %GENIEXPROC%
DriverVer   = 01/01/2026,1.0.0.0
CatalogFile = libgeniex-proc-htp.cat
PnpLockDown = 1

[DestinationDirs]
Drivers_Dir = 13

[SourceDisksNames]
1 = %DiskId%

[SourceDisksFiles]
@GENIEXPROC_HTP_SOURCE_FILES@

[ControlFlags]
ExcludeFromSelect = *

[DefaultInstall.NTarm64]
CopyFiles=Drivers_Dir

[Drivers_Dir]
@GENIEXPROC_HTP_COPY_FILES@

[Strings]
GENIEXPROC = 'geniex-proc'
DiskId      = 'geniex-proc HTP kernel library'
